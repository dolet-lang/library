# Linux x86_64 GNU ABI bindings used by the platform implementation.
# These are implementation details. Portable programs use std; advanced
# programs may explicitly import sys.linux.libc.

extern lib "c":
    # memory
    fun malloc(size: i64) -> i64
    fun calloc(count: i64, size: i64) -> i64
    fun realloc(mem: i64, size: i64) -> i64
    fun free(mem: i64)

    # files and paths
    fun open(path: str, flags: i32, mode: i32) -> i32
    fun close(fd: i32) -> i32
    fun read(fd: i32, buffer: i64, count: i64) -> i64
    fun write(fd: i32, buffer: i64, count: i64) -> i64
    fun lseek(fd: i32, offset: i64, whence: i32) -> i64
    fun unlink(path: str) -> i32
    fun access(path: str, mode: i32) -> i32
    fun getcwd(buffer: i64, size: i64) -> i64
    fun readlink(path: str, buffer: i64, size: i64) -> i64
    fun realpath(path: str, resolved: i64) -> i64

    # process and stdio
    fun exit(code: i32)
    fun system(command: str) -> i32
    fun popen(command: str, mode: str) -> i64
    fun pclose(stream: i64) -> i32
    fun fread(buffer: i64, size: i64, count: i64, stream: i64) -> i64
    fun pipe(descriptors: i64) -> i32
    fun fork() -> i32
    fun dup2(old_fd: i32, new_fd: i32) -> i32
    fun execv(path: str, arguments: i64) -> i32
    fun _exit(code: i32)
    fun waitpid(pid: i32, status: i64, options: i32) -> i32
    fun poll(descriptors: i64, count: i64, timeout_ms: i32) -> i32

    # directories
    fun opendir(path: str) -> i64
    fun readdir(dir: i64) -> i64
    fun closedir(dir: i64) -> i32

    # clocks and scheduling
    fun clock_gettime(clock_id: i32, timespec: i64) -> i32
    fun nanosleep(request: i64, remaining: i64) -> i32
    fun sched_yield() -> i32
    fun sysconf(name: i32) -> i64

    # POSIX sockets
    fun socket(domain: i32, socket_type: i32, protocol: i32) -> i32
    fun bind(fd: i32, address: i64, length: i32) -> i32
    fun listen(fd: i32, backlog: i32) -> i32
    fun accept(fd: i32, address: i64, length: i64) -> i32
    fun connect(fd: i32, address: i64, length: i32) -> i32
    fun send(fd: i32, buffer: i64, length: i64, flags: i32) -> i64
    fun recv(fd: i32, buffer: i64, length: i64, flags: i32) -> i64
    fun setsockopt(fd: i32, level: i32, name: i32, value: i64, length: i32) -> i32
    fun htons(value: i16) -> i16
    fun inet_addr(address: str) -> i32
    # Implemented by this target pack's runtime_helpers.o, declared in the
    # libc group so no synthetic import library is requested.
    fun __dolet_linux_arena_state() -> i64

extern lib "pthread":
    fun pthread_create(thread_out: i64, attributes: i64, entry: i64, argument: i64) -> i32
    fun pthread_join(thread: i64, result_out: i64) -> i32
    fun pthread_self() -> i64
    fun pthread_mutex_init(mutex: i64, attributes: i64) -> i32
    fun pthread_mutex_destroy(mutex: i64) -> i32
    fun pthread_mutex_lock(mutex: i64) -> i32
    fun pthread_mutex_unlock(mutex: i64) -> i32
    fun pthread_mutex_trylock(mutex: i64) -> i32
    fun pthread_cond_init(condition: i64, attributes: i64) -> i32
    fun pthread_cond_destroy(condition: i64) -> i32
    fun pthread_cond_timedwait(condition: i64, mutex: i64, deadline: i64) -> i32
    fun pthread_cond_broadcast(condition: i64) -> i32
