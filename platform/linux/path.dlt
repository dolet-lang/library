requires platform/linux/libc

struct PathOps:
    static fun get_exe_path() -> str:
        capacity: i64 = 4096
        buffer: i64 = Memory.malloc(capacity)
        if buffer == 0:
            return ""
        length: i64 = readlink("/proc/self/exe", buffer, capacity - 1)
        if length <= 0:
            Memory.free(buffer)
            return ""
        Memory.write_i8(buffer + length, 0 as i8)
        return buffer as str

    static fun get_exe_directory() -> str:
        exe_path: str = PathOps.get_exe_path()
        if Memory.strlen(exe_path) == 0:
            return PathOps.get_cwd()
        sep: i64 = PathOps.find_last_separator(exe_path)
        if sep < 0:
            Memory.free(exe_path as i64)
            return PathOps.get_cwd()
        result: i64 = Memory.malloc(sep + 2)
        Memory.copy(result, exe_path as i64, sep + 1)
        Memory.write_i8(result + sep + 1, 0 as i8)
        Memory.free(exe_path as i64)
        return result as str

    static fun get_cwd() -> str:
        result: i64 = getcwd(0, 0)
        if result == 0:
            return ""
        return result as str

    static fun exists(path: str) -> i32:
        if access(path, 0) == 0:
            return 1
        return 0

    static fun resolve_path(path: str) -> str:
        if Memory.strlen(path) == 0:
            return PathOps.get_cwd()
        resolved: i64 = realpath(path, 0)
        if resolved != 0:
            return resolved as str
        return Str.strcpy(path)

    static fun resolve_from_exe(path: str) -> str:
        if PathOps.is_absolute(path):
            return Str.strcpy(path)
        base: str = PathOps.get_exe_directory()
        result: str = PathOps.join_path(base, path)
        Memory.free(base as i64)
        return result

    static fun normalize(path: str) -> str:
        path_len: i64 = Memory.strlen(path)
        out: i64 = Memory.malloc(path_len + 1)
        src: i64 = 0
        dst: i64 = 0
        previous_sep: bool = false
        c: i8 = 0 as i8
        is_sep: bool = false
        while src < path_len:
            c = Memory.read_i8((path as i64) + src)
            is_sep = c == 47
            if not (is_sep and previous_sep):
                Memory.write_i8(out + dst, c)
                dst = dst + 1
            previous_sep = is_sep
            src = src + 1
        Memory.write_i8(out + dst, 0 as i8)
        return out as str

    static fun is_absolute(path: str) -> bool:
        if Memory.strlen(path) == 0:
            return false
        return Memory.read_i8(path as i64) == 47 as i8

    static fun join_path(base: str, relative: str) -> str:
        if PathOps.is_absolute(relative):
            return Str.strcpy(relative)
        base_len: i64 = Memory.strlen(base)
        relative_len: i64 = Memory.strlen(relative)
        add_separator: i64 = 1
        if base_len == 0 or Memory.read_i8((base as i64) + base_len - 1) == 47 as i8:
            add_separator = 0
        result: i64 = Memory.malloc(base_len + add_separator + relative_len + 1)
        Memory.copy(result, base as i64, base_len)
        if add_separator == 1:
            Memory.write_i8(result + base_len, 47 as i8)
        Memory.copy(result + base_len + add_separator, relative as i64, relative_len)
        Memory.write_i8(result + base_len + add_separator + relative_len, 0 as i8)
        return result as str

    static fun find_last_separator(path: str) -> i64:
        pos: i64 = Memory.strlen(path) - 1
        while pos >= 0:
            if Memory.read_i8((path as i64) + pos) == 47 as i8:
                return pos
            pos = pos - 1
        return -1

    static fun get_filename(path: str) -> str:
        path_len: i64 = Memory.strlen(path)
        sep: i64 = PathOps.find_last_separator(path)
        start: i64 = sep + 1
        length: i64 = path_len - start
        result: i64 = Memory.malloc(length + 1)
        Memory.copy(result, (path as i64) + start, length)
        Memory.write_i8(result + length, 0 as i8)
        return result as str

    static fun get_extension(path: str) -> str:
        name: str = PathOps.get_filename(path)
        name_len: i64 = Memory.strlen(name)
        dot: i64 = name_len - 1
        length: i64 = 0
        result: i64 = 0
        while dot >= 0:
            if Memory.read_i8((name as i64) + dot) == 46 as i8:
                length = name_len - dot
                result = Memory.malloc(length + 1)
                Memory.copy(result, (name as i64) + dot, length)
                Memory.write_i8(result + length, 0 as i8)
                Memory.free(name as i64)
                return result as str
            dot = dot - 1
        Memory.free(name as i64)
        return ""

    static fun get_directory(path: str) -> str:
        sep: i64 = PathOps.find_last_separator(path)
        if sep < 0:
            return ""
        result: i64 = Memory.malloc(sep + 2)
        Memory.copy(result, path as i64, sep + 1)
        Memory.write_i8(result + sep + 1, 0 as i8)
        return result as str
