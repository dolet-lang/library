requires platform/linux/libc

struct Dir:
    static fun list(path: str) -> list<str>:
        result: list<str> = []
        directory: i64 = opendir(path)
        if directory == 0:
            return result
        scanning: bool = true
        entry: i64 = 0
        name: str = ""
        is_dot: bool = false
        second: i8 = 0 as i8
        while scanning:
            entry = readdir(directory)
            if entry == 0:
                scanning = false
            else:
                # Linux x86_64 glibc struct dirent places d_name at byte 19.
                name = (entry + 19) as str
                is_dot = false
                if Memory.read_i8(name as i64) == 46 as i8:
                    second = Memory.read_i8((name as i64) + 1)
                    if second == 0 as i8:
                        is_dot = true
                    elif second == 46 as i8 and Memory.read_i8((name as i64) + 2) == 0 as i8:
                        is_dot = true
                if not is_dot:
                    result.append(Str.strcpy(name))
        closedir(directory)
        return result
