requires platform/linux/libc

fun __linux_read_cmdline() -> i64:
    fd: i32 = open("/proc/self/cmdline", 0, 0)
    if fd < 0:
        return 0
    capacity: i64 = 4096
    length: i64 = 0
    block: i64 = Memory.malloc(capacity + 8)
    if block == 0:
        close(fd)
        return 0
    buffer: i64 = block + 8
    reading: bool = true
    got: i64 = 0
    grown: i64 = 0
    while reading:
        if length + 2048 + 1 > capacity:
            capacity = capacity * 2
            grown = Memory.realloc(block, capacity + 8)
            if grown == 0:
                close(fd)
                Memory.free(block)
                return 0
            block = grown
            buffer = block + 8
        got = read(fd, buffer + length, capacity - length - 1)
        if got <= 0:
            reading = false
        else:
            length = length + got
    close(fd)
    Memory.write_i8(buffer + length, 0 as i8)
    Memory.write_i64(block, length)
    return block

struct Args:
    static fun get_raw() -> str:
        block: i64 = __linux_read_cmdline()
        if block == 0:
            return ""
        length: i64 = Memory.read_i64(block)
        source: i64 = block + 8
        result: i64 = Memory.malloc(length + 1)
        Memory.copy(result, source, length)
        i: i64 = 0
        while i + 1 < length:
            if Memory.read_i8(result + i) == 0 as i8:
                Memory.write_i8(result + i, 32 as i8)
            i = i + 1
        Memory.write_i8(result + length, 0 as i8)
        Memory.free(block)
        return result as str

    static fun count() -> i32:
        block: i64 = __linux_read_cmdline()
        if block == 0:
            return 0
        total: i64 = Memory.read_i64(block)
        buffer: i64 = block + 8
        if total <= 0:
            Memory.free(block)
            return 0
        count: i32 = 0
        i: i64 = 0
        while i < total:
            if Memory.read_i8(buffer + i) == 0 as i8:
                count = count + 1
            i = i + 1
        Memory.free(block)
        return count

    static fun get(index: i32) -> str:
        if index < 0:
            return ""
        block: i64 = __linux_read_cmdline()
        if block == 0:
            return ""
        total: i64 = Memory.read_i64(block)
        buffer: i64 = block + 8
        current: i32 = 0
        cursor: i64 = 0
        while current < index and cursor < total:
            cursor = cursor + Memory.strlen((buffer + cursor) as str) + 1
            current = current + 1
        if cursor >= total:
            Memory.free(block)
            return ""
        result: str = Str.strcpy((buffer + cursor) as str)
        Memory.free(block)
        return result
