requires platform/linux/kernel

fun __thread_entry(env: i64) -> i64:
    closure: @heap fun() = env as @heap fun()
    closure()
    return 0

struct Thread:
    # Base of a target-owned mapping. Offset 0 is the kernel clear-tid word;
    # offset 8 stores the complete stack/TLS mapping size.
    handle: i64

attach Thread:
    static fun spawn(f: @heap fun()) -> Thread:
        return Thread(handle=__dolet_thread_spawn(__thread_entry as i64, f as i64))

    fun join(self):
        if self.handle == 0:
            return
        tid: i32 = __atomic_load_i32(self.handle)
        while tid != 0:
            __linux_futex(self.handle, 0, tid, 0)
            tid = __atomic_load_i32(self.handle)
        mapping_size: i64 = Memory.read_i64(self.handle + 8)
        if mapping_size > 0:
            __linux_munmap(self.handle, mapping_size)

    static fun sleep(ms: i32):
        if ms <= 0:
            return
        request: i64 = Memory.malloc_zeroed(16)
        Memory.write_i64(request, (ms / 1000) as i64)
        Memory.write_i64(request + 8, ((ms - ((ms / 1000) * 1000)) as i64) * 1000000)
        nanosleep(request, 0)
        Memory.free(request)

    static fun yield_now():
        sched_yield()

    static fun current_id() -> i32:
        return __linux_gettid()

# Manual-reset broadcast event. One atomic word and FUTEX_WAIT/FUTEX_WAKE
# replace the old pthread mutex+condition allocation.
PARK_EVENT_STORAGE: i64 = 4

@heap
struct ParkEvent:
    state: i64

attach ParkEvent:
    static fun new() -> ParkEvent:
        return ParkEvent(state=Memory.malloc_zeroed(PARK_EVENT_STORAGE))

    fun wait(self, ms: i32):
        if self.state == 0 or __atomic_load_i32(self.state) != 0:
            return
        timeout: i64 = 0
        if ms >= 0:
            timeout = Memory.malloc_zeroed(16)
            Memory.write_i64(timeout, (ms / 1000) as i64)
            Memory.write_i64(timeout + 8, ((ms - ((ms / 1000) * 1000)) as i64) * 1000000)
        __linux_futex(self.state, 0, 0, timeout)
        if timeout != 0:
            Memory.free(timeout)

    fun signal(self):
        if self.state == 0:
            return
        __atomic_store_i32(self.state, 1)
        __linux_futex(self.state, 1, 2147483647, 0)

    fun reset(self):
        if self.state != 0:
            __atomic_store_i32(self.state, 0)

    fun destroy(self):
        if self.state != 0:
            Memory.free(self.state)
            self.state = 0
