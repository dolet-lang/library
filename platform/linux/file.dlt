requires platform/linux/kernel

struct FileOps:
    static fun file_delete(path: str) -> i32:
        if unlink(path) == 0:
            return 1
        return 0

    static fun file_open_read(path: str) -> i64:
        return open(path, 0, 0) as i64

    static fun file_open_write(path: str) -> i64:
        return open(path, 577, 438) as i64

    static fun file_open_append(path: str) -> i64:
        return open(path, 1089, 438) as i64

    static fun file_open_rw(path: str) -> i64:
        return open(path, 66, 438) as i64

    static fun file_close(handle: i64):
        if handle >= 0:
            close(handle as i32)

    static fun file_read(handle: i64, buffer: i64, size: i32) -> i32:
        return read(handle as i32, buffer, size as i64) as i32

    static fun file_write(handle: i64, buffer: i64, size: i32) -> i32:
        return write(handle as i32, buffer, size as i64) as i32

    static fun file_write_str(handle: i64, text: str) -> i32:
        return FileOps.file_write(handle, text as i64, Memory.strlen(text) as i32)

    static fun file_seek_begin(handle: i64, offset: i32) -> i32:
        return lseek(handle as i32, offset as i64, 0) as i32

    static fun file_seek_current(handle: i64, offset: i32) -> i32:
        return lseek(handle as i32, offset as i64, 1) as i32

    static fun file_seek_end(handle: i64, offset: i32) -> i32:
        return lseek(handle as i32, offset as i64, 2) as i32

    static fun file_tell(handle: i64) -> i32:
        return lseek(handle as i32, 0, 1) as i32

    static fun file_size(handle: i64) -> i32:
        current: i64 = lseek(handle as i32, 0, 1)
        ending: i64 = lseek(handle as i32, 0, 2)
        lseek(handle as i32, current, 0)
        return ending as i32

    static fun file_read_all(handle: i64) -> i64:
        size: i32 = FileOps.file_size(handle)
        if size < 0:
            return 0
        FileOps.file_seek_begin(handle, 0)
        buffer: i64 = Memory.malloc((size as i64) + 1)
        if buffer == 0:
            return 0
        got: i32 = FileOps.file_read(handle, buffer, size)
        if got < 0:
            Memory.free(buffer)
            return 0
        Memory.write_i8(buffer + (got as i64), 0 as i8)
        return buffer

    static fun file_is_valid(handle: i64) -> bool:
        return handle >= 0
