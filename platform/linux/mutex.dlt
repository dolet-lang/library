requires platform/linux/libc

LINUX_MUTEX_STORAGE: i64 = 64

@heap
struct Mutex:
    state: i64

attach Mutex:
    static fun new() -> Mutex:
        state: i64 = Memory.malloc_zeroed(LINUX_MUTEX_STORAGE)
        rc: i32 = pthread_mutex_init(state, 0)
        if rc != 0:
            Memory.free(state)
            return Mutex(state=0)
        return Mutex(state=state)

    fun lock(self):
        if self.state != 0:
            pthread_mutex_lock(self.state)

    fun unlock(self):
        if self.state != 0:
            pthread_mutex_unlock(self.state)

    fun try_lock(self) -> bool:
        if self.state == 0:
            return false
        return pthread_mutex_trylock(self.state) == 0

    fun with(self, body: @heap fun()):
        self.lock()
        body()
        self.unlock()

    fun destroy(self):
        if self.state != 0:
            pthread_mutex_destroy(self.state)
            Memory.free(self.state)
            self.state = 0
