requires platform/linux/kernel

# A four-byte futex word is the entire mutex state. The uncontended path is
# one cmpxchg; the kernel is entered only after contention.
LINUX_MUTEX_STORAGE: i64 = 4

@heap
struct Mutex:
    state: i64

attach Mutex:
    static fun new() -> Mutex:
        return Mutex(state=Memory.malloc_zeroed(LINUX_MUTEX_STORAGE))

    fun lock(self):
        if self.state == 0:
            return
        acquired: bool = false
        while not acquired:
            acquired = __atomic_cas_i32(self.state, 0, 1)
            if not acquired:
                __linux_futex(self.state, 0, 1, 0)

    fun unlock(self):
        if self.state == 0:
            return
        __atomic_store_i32(self.state, 0)
        __linux_futex(self.state, 1, 1, 0)

    fun try_lock(self) -> bool:
        if self.state == 0:
            return false
        return __atomic_cas_i32(self.state, 0, 1)

    fun with(self, body: @heap fun()):
        self.lock()
        body()
        self.unlock()

    fun destroy(self):
        if self.state != 0:
            Memory.free(self.state)
            self.state = 0
