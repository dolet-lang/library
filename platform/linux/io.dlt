requires platform/linux/kernel

struct IOOps:
    static fun io_println(text: str):
        text_len: i64 = Memory.strlen(text)
        newline: str = "\n"
        write(1, text as i64, text_len)
        write(1, newline as i64, 1)

    static fun io_print(text: str):
        write(1, text as i64, Memory.strlen(text))
