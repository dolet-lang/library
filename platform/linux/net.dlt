requires platform/linux/kernel

struct NetOps:
    static fun net_init() -> i32:
        return 0

    static fun net_socket_create() -> i64:
        return socket(2, 1, 6) as i64

    static fun net_socket_bind(sock: i64, host: str, port: i32) -> i32:
        address: i64 = Memory.malloc_zeroed(16)
        Memory.write_i16(address, 2 as i16)
        Memory.write_i16(address + 2, htons(port as i16))
        Memory.write_i32(address + 4, inet_addr(host))
        rc: i32 = bind(sock as i32, address, 16)
        Memory.free(address)
        return rc

    static fun net_socket_listen(sock: i64, backlog: i32) -> i32:
        return listen(sock as i32, backlog)

    static fun net_socket_accept(sock: i64) -> i64:
        return accept(sock as i32, 0, 0) as i64

    static fun net_socket_send(sock: i64, data: str) -> i32:
        return send(sock as i32, data as i64, Memory.strlen(data), 0) as i32

    static fun net_socket_recv(sock: i64, buffer: i64, size: i32) -> i32:
        return recv(sock as i32, buffer, size as i64, 0) as i32

    static fun net_socket_close(sock: i64) -> i32:
        return close(sock as i32)
