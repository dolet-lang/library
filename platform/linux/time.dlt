requires platform/linux/kernel

struct TimeOps:
    static fun time_sleep(seconds: f64):
        if seconds <= 0.0:
            return
        whole: i64 = seconds as i64
        fraction: f64 = seconds - (whole as f64)
        request: i64 = Memory.malloc_zeroed(16)
        Memory.write_i64(request, whole)
        Memory.write_i64(request + 8, (fraction * 1000000000.0) as i64)
        nanosleep(request, 0)
        Memory.free(request)

    static fun time_sleep_ms(ms: i64):
        if ms <= 0:
            return
        request: i64 = Memory.malloc_zeroed(16)
        Memory.write_i64(request, ms / 1000)
        Memory.write_i64(request + 8, (ms - ((ms / 1000) * 1000)) * 1000000)
        nanosleep(request, 0)
        Memory.free(request)

    static fun time_now() -> f64:
        value: i64 = Memory.malloc_zeroed(16)
        clock_gettime(1, value)
        seconds: i64 = Memory.read_i64(value)
        nanos: i64 = Memory.read_i64(value + 8)
        Memory.free(value)
        return (seconds as f64) + ((nanos as f64) / 1000000000.0)

    static fun time_now_ms() -> i64:
        value: i64 = Memory.malloc_zeroed(16)
        clock_gettime(1, value)
        seconds: i64 = Memory.read_i64(value)
        nanos: i64 = Memory.read_i64(value + 8)
        Memory.free(value)
        return (seconds * 1000) + (nanos / 1000000)

    static fun time_now_ns() -> i64:
        value: i64 = Memory.malloc_zeroed(16)
        clock_gettime(1, value)
        seconds: i64 = Memory.read_i64(value)
        nanos: i64 = Memory.read_i64(value + 8)
        Memory.free(value)
        return (seconds * 1000000000) + nanos
