requires platform/linux/kernel

struct Output:
    code: i32
    stdout: str
    stderr: str

fun __linux_wait_code(status: i32) -> i32:
    signal: i32 = status & 127
    if signal == 0:
        return (status >> 8) & 255
    return 128 + signal

fun __linux_capture(command: str) -> Output:
    # Keep one syscall-native capture engine. The former popen/fread path
    # silently pulled a C runtime into every program importing std.
    captured: Output = __linux_output(command)
    if Memory.strlen(captured.stderr) == 0:
        return captured
    merged: str = Str.concat(captured.stdout, captured.stderr)
    return Output(code=captured.code, stdout=merged, stderr="")

fun __linux_output(command: str) -> Output:
    out_pipe: i64 = Memory.malloc_zeroed(8)
    err_pipe: i64 = Memory.malloc_zeroed(8)
    if out_pipe == 0 or err_pipe == 0:
        if out_pipe != 0:
            Memory.free(out_pipe)
        if err_pipe != 0:
            Memory.free(err_pipe)
        return Output(code=-1, stdout="", stderr="")
    if pipe(out_pipe) != 0:
        Memory.free(out_pipe)
        Memory.free(err_pipe)
        return Output(code=-1, stdout="", stderr="")
    if pipe(err_pipe) != 0:
        close(Memory.read_i32(out_pipe))
        close(Memory.read_i32(out_pipe + 4))
        Memory.free(out_pipe)
        Memory.free(err_pipe)
        return Output(code=-1, stdout="", stderr="")

    out_read: i32 = Memory.read_i32(out_pipe)
    out_write: i32 = Memory.read_i32(out_pipe + 4)
    err_read: i32 = Memory.read_i32(err_pipe)
    err_write: i32 = Memory.read_i32(err_pipe + 4)
    pid: i32 = fork()
    if pid == 0:
        close(out_read)
        close(err_read)
        dup2(out_write, 1)
        dup2(err_write, 2)
        close(out_write)
        close(err_write)
        arguments: i64 = Memory.malloc_zeroed(32)
        if arguments == 0:
            _exit(127)
        Memory.write_i64(arguments, "sh" as i64)
        Memory.write_i64(arguments + 8, "-c" as i64)
        Memory.write_i64(arguments + 16, command as i64)
        Memory.write_i64(arguments + 24, 0)
        execv("/bin/sh", arguments)
        _exit(127)

    close(out_write)
    close(err_write)
    Memory.free(out_pipe)
    Memory.free(err_pipe)
    if pid < 0:
        close(out_read)
        close(err_read)
        return Output(code=-1, stdout="", stderr="")

    # Match Windows: retain at most 1 MiB from each stream, but keep draining
    # everything. A hard read stop lets a verbose child fill its pipe and
    # deadlock forever; unbounded realloc lets hostile output exhaust memory.
    capture_limit: i64 = 1048576
    out_length: i64 = 0
    err_length: i64 = 0
    out_buffer: i64 = Memory.malloc_zeroed(capture_limit + 1)
    err_buffer: i64 = Memory.malloc_zeroed(capture_limit + 1)
    chunk: i64 = Memory.malloc(4096)
    pollfds: i64 = Memory.malloc_zeroed(16)
    if out_buffer == 0 or err_buffer == 0 or chunk == 0 or pollfds == 0:
        # Closing both read ends guarantees a verbose child cannot remain
        # blocked on a full pipe while we reap it after an allocation failure.
        close(out_read)
        close(err_read)
        waitpid(pid, 0, 0)
        if out_buffer != 0:
            Memory.free(out_buffer)
        if err_buffer != 0:
            Memory.free(err_buffer)
        if chunk != 0:
            Memory.free(chunk)
        if pollfds != 0:
            Memory.free(pollfds)
        return Output(code=-1, stdout="", stderr="")
    out_open: bool = true
    err_open: bool = true
    poll_result: i32 = 0
    out_events: i16 = 0 as i16
    err_events: i16 = 0 as i16
    got_out: i64 = 0
    got_err: i64 = 0
    copy_out: i64 = 0
    copy_err: i64 = 0

    while out_open or err_open:
        if out_open:
            Memory.write_i32(pollfds, out_read)
        else:
            Memory.write_i32(pollfds, -1)
        Memory.write_i16(pollfds + 4, 1 as i16)
        Memory.write_i16(pollfds + 6, 0 as i16)
        if err_open:
            Memory.write_i32(pollfds + 8, err_read)
        else:
            Memory.write_i32(pollfds + 8, -1)
        Memory.write_i16(pollfds + 12, 1 as i16)
        Memory.write_i16(pollfds + 14, 0 as i16)

        poll_result = poll(pollfds, 2, -1)
        if poll_result >= 0:
            out_events = Memory.read_i16(pollfds + 6)
            err_events = Memory.read_i16(pollfds + 14)
            if out_open and out_events != 0 as i16:
                got_out = read(out_read, chunk, 4096)
                if got_out <= 0:
                    close(out_read)
                    out_open = false
                else:
                    copy_out = got_out
                    if out_length + copy_out > capture_limit:
                        copy_out = capture_limit - out_length
                    if copy_out > 0:
                        Memory.copy(out_buffer + out_length, chunk, copy_out)
                        out_length = out_length + copy_out
            if err_open and err_events != 0 as i16:
                got_err = read(err_read, chunk, 4096)
                if got_err <= 0:
                    close(err_read)
                    err_open = false
                else:
                    copy_err = got_err
                    if err_length + copy_err > capture_limit:
                        copy_err = capture_limit - err_length
                    if copy_err > 0:
                        Memory.copy(err_buffer + err_length, chunk, copy_err)
                        err_length = err_length + copy_err

    Memory.write_i8(out_buffer + out_length, 0 as i8)
    Memory.write_i8(err_buffer + err_length, 0 as i8)
    status_ptr: i64 = Memory.malloc_zeroed(4)
    if status_ptr == 0:
        waitpid(pid, 0, 0)
        Memory.free(out_buffer)
        Memory.free(err_buffer)
        Memory.free(chunk)
        Memory.free(pollfds)
        return Output(code=-1, stdout="", stderr="")
    waitpid(pid, status_ptr, 0)
    status: i32 = Memory.read_i32(status_ptr)
    code: i32 = __linux_wait_code(status)
    stdout_clean: str = Str.trim(out_buffer as str)
    stderr_clean: str = Str.trim(err_buffer as str)
    Memory.free(status_ptr)
    Memory.free(out_buffer)
    Memory.free(err_buffer)
    Memory.free(chunk)
    Memory.free(pollfds)
    return Output(code=code, stdout=stdout_clean, stderr=stderr_clean)

struct Process:
    static fun exit(code: i32):
        exit(code)

    static fun run(command: str) -> i32:
        status: i32 = system(command)
        if status < 0:
            return status
        return __linux_wait_code(status)

    static fun run_capture(command: str) -> str:
        captured: Output = __linux_capture(command)
        return captured.stdout

    static fun run_output(command: str) -> Output:
        return __linux_output(command)
